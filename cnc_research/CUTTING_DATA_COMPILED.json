  "formulas": {
    "rpm_from_sfm": {
      "description": "Calculate RPM from surface feet per minute and diameter",
      "formula": "RPM = (SFM × 12) / (π × Diameter_inches)",
      "simplified_formula": "RPM = (SFM × 3.82) / Diameter_inches",
      "metric_formula": "RPM = (1000 × Vc_m_per_min) / (π × Diameter_mm)",
      "example": {
        "material": "Aluminum 6061",
        "sfm": 500,
        "diameter_inches": 0.5,
        "rpm_result": 3819
      }
    },
    "sfm_from_rpm": {
      "description": "Calculate surface feet per minute from RPM and diameter",
      "formula": "SFM = (RPM × π × Diameter_inches) / 12",
      "simplified_formula": "SFM = (RPM × Diameter_inches) / 3.82"
    },
    "feed_rate_from_ipt": {
      "description": "Calculate feed rate in inches per minute from IPT and flute count",
      "formula": "IPM = IPT × Number_of_Flutes × RPM",
      "variables": {
        "IPT": "Inches per tooth (chip load)",
        "Number_of_Flutes": "Flute count of cutter",
        "RPM": "Revolutions per minute"
      },
      "example": {
        "ipt": 0.015,
        "flutes": 4,
        "rpm": 3819,
        "ipm_result": 228.5
      }
    },
    "chip_load_calculation": {
      "description": "Calculate actual chip thickness being created",
      "formula": "Chip_Load = Feed_Per_Minute / (RPM × Number_of_Flutes)"
    },
    "horsepower_milling": {
      "description": "Estimate horsepower required for milling",
      "formula": "HP = (Vc × feed × depth) / (material_constant × 12)",
      "notes": "Material constant varies by material; consult references"
    }
  },
